  "swap": "on Long Rest (or level up when new options unlock)",
  "properties": {
   "cleave": "After hitting with melee attack, make one extra attack vs second creature within 5ft of first and within reach; no ability mod to damage. Once per turn. (Greataxe, Halberd)",
   "graze": "On a miss, deal damage equal to the ability modifier used for the attack roll. (Glaive, Greatsword)",
   "nick": "Light-weapon extra attack becomes part of Attack action instead of Bonus Action. Once per turn. (Dagger, Light Hammer, Sickle, Scimitar)",
   "push": "On hit, push Large-or-smaller creature up to 10ft straight away. (Greatclub, Pike, Warhammer, Heavy Crossbow)",
   "sap": "On hit, target has Disadvantage on its next attack roll before start of your next turn. (Mace, Spear, Flail, Longsword, Morningstar, War Pick)",
   "slow": "On hit with damage, reduce target Speed by 10ft until start of your next turn (doesn't stack past 10ft). (Club, Javelin, Light Crossbow, Sling, Whip, Longbow, Musket)",
   "topple": "On hit, target makes CON save (DC 8 + attack ability mod + PB) or falls Prone. (Quarterstaff, Battleaxe, Lance, Maul, Trident)",
   "vex": "On hit with damage, Advantage on your next attack roll vs that creature before end of your next turn. (Handaxe, Dart, Shortbow, Rapier, Shortsword, Blowgun, Hand Crossbow, Pistol)"
  },
  "fighter_tactical_master": "Level 9+: replace a mastery with Push/Sap/Slow for an attack",
