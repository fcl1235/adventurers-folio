 "misc_rules_2024": {
  "heroic_inspiration": "Reroll any one die (not just d20) after a roll, must use new result; can gift to another player if you already have one.",
  "hide_action": "DC 15 DEX(Stealth) check; must be Heavily Obscured or 3/4 cover; success grants Invisible condition.",
  "potion_of_healing": "Drink = Bonus Action; administer to another = Action.",
  "surprised": "Disadvantage on Initiative only (no lost turn/reaction).",
  "long_rest": "8h (6h sleep), start with 1+ HP, recovers ALL hit dice, once per 24h (16h between), interruptions add +1h each.",
  "unarmed_strike": "Options: damage attack / Grapple (target STR or DEX save) / Shove (target STR or DEX save). One hand = one grapple.",
  "two_weapon_fighting": "Light weapons (incl. ranged/thrown) grant Bonus Action attack with another Light weapon.",
