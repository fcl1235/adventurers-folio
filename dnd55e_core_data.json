 "formulas": {
  "ability_mod": "floor((score - 10) / 2)",
  "proficiency_bonus": "2 + floor((level - 1) / 4)",
  "skill_check": "d20 + ability_mod + (proficient ? PB : 0) + (expertise ? PB : 0)",
  "spell_save_dc": "8 + casting_ability_mod + PB",
  "spell_attack": "d20 + casting_ability_mod + PB",
  "hp_level_1": "hit_die_max + CON_mod",
  "passive_perception": "10 + perception_mod",
  "initiative": "DEX_mod (+ PB if Alert feat)"
 }
